import {
  useState
} from "react";

import HomePage
  from "./pages/HomePage";

import Article11Page
  from "./pages/Article11Page";

import Article13Page
  from "./pages/Article13Page";

import Article14Page
  from "./pages/Article14Page";

import WaterEngineeringPage
  from "./pages/WaterEngineeringPage";

import MetalsAndMiningPage
  from "./pages/MetalsAndMiningPage";

import MovablePropertyPage
  from "./pages/MovablePropertyPage";

import FinancialAffairsPage
  from "./pages/FinancialAffairsPage";

import VehiclePage
  from "./pages/VehiclePage";

import RoadBuildingPage from "./pages/RoadBuildingPage";
import IndustryTechnologyPage from "./pages/IndustryTechnologyPage";
import AgricultureNaturalResourcesPage from "./pages/AgricultureNaturalResourcesPage";
import ExpertRecordsPage from "./pages/ExpertRecordsPage";
import AboutPage from "./pages/AboutPage";
import type { ExpertCaseDraft } from "./records/ExpertCaseDraft";


type AppPage =
  | "HOME"
  | "ARTICLE_11"
  | "ARTICLE_13"
  | "ARTICLE_14"
  | "WATER_ENGINEERING"
  | "METALS_AND_MINING"
  | "MOVABLE_PROPERTY"
  | "FINANCIAL_AFFAIRS"
  | "VEHICLES"
  | "ROAD_BUILDING"
  | "INDUSTRY_TECHNOLOGY"
  | "AGRICULTURE_NATURAL_RESOURCES"
  | "EXPERT_RECORDS"
  | "ABOUT";


export default function App() {

  const [
    currentPage,
    setCurrentPage
  ] = useState<AppPage>("HOME");

  const [
    pendingExpertCaseDraft,
    setPendingExpertCaseDraft
  ] = useState<ExpertCaseDraft | null>(
    null
  );


  function goHome(): void {
    setCurrentPage("HOME");
  }


  function openArticle11(): void {
    setCurrentPage("ARTICLE_11");
  }

  function openAbout(): void {
    setCurrentPage("ABOUT");
  }

  function openRecordsWithDraft(
    draft: ExpertCaseDraft
  ): void {
    setPendingExpertCaseDraft(
      draft
    );
    setCurrentPage(
      "EXPERT_RECORDS"
    );
  }


  return (

    <div
      dir="rtl"
      style={{
        minHeight: "100vh",
        background: "#f8fafc",
        fontFamily: "inherit"
      }}
    >

      {/* =====================================
          Header
          ===================================== */}

      {currentPage !== "HOME" && (
      <header
        style={{
          background: "#ffffff",
          borderBottom: "1px solid #e2e8f0",
          padding: "20px"
        }}
      >

        <div
          style={{
            maxWidth: 900,
            margin: "0 auto"
          }}
        >

          <h1
            style={{
              margin: 0
            }}
          >
            ExpertFee
          </h1>


          <p
            style={{
              marginTop: 8,
              marginBottom: 0,
              opacity: 0.7
            }}
          >
            محاسبه حق‌الزحمه کارشناسان رسمی دادگستری
          </p>

        </div>

      </header>
      )}


      {/* =====================================
          Home
          ===================================== */}

      {currentPage === "HOME" && (

        <HomePage

          onOpenArticle11={
            openArticle11
          }

          onOpenArticle13={() => {
            setCurrentPage(
              "ARTICLE_13"
            );
          }}

          onOpenArticle14={() => {
            setCurrentPage(
              "ARTICLE_14"
            );
          }}

          onOpenWaterEngineering={() => {
            setCurrentPage(
              "WATER_ENGINEERING"
            );
          }}

          onOpenMetalsAndMining={() => {
            setCurrentPage(
              "METALS_AND_MINING"
            );
          }}

          onOpenMovableProperty={() => {
            setCurrentPage(
              "MOVABLE_PROPERTY"
            );
          }}

          onOpenFinancialAffairs={() => {
            setCurrentPage(
              "FINANCIAL_AFFAIRS"
            );
          }}

          onOpenVehicles={() => {
            setCurrentPage(
              "VEHICLES"
            );
          }}

          onOpenRoadBuilding={() => setCurrentPage("ROAD_BUILDING")}
          onOpenIndustryTechnology={() => setCurrentPage("INDUSTRY_TECHNOLOGY")}
          onOpenAgricultureNaturalResources={() => setCurrentPage("AGRICULTURE_NATURAL_RESOURCES")}
          onOpenHistory={() => {
            setPendingExpertCaseDraft(null);
            setCurrentPage("EXPERT_RECORDS");
          }}

        />

      )}


      {/* =====================================
          Article 11
          ===================================== */}

      {currentPage === "ARTICLE_11" && (

        <div>

          <div
            style={{
              maxWidth: 900,
              margin: "20px auto 0",
              padding: "0 24px"
            }}
          >

            <button
              type="button"
              onClick={goHome}
              style={{
                padding: "9px 16px",
                border: "1px solid #cbd5e1",
                borderRadius: 8,
                background: "#ffffff",
                cursor: "pointer",
                fontFamily: "inherit"
              }}
            >
              ← بازگشت به صفحه اصلی
            </button>

          </div>


          <Article11Page
            onSaveCalculation={
              openRecordsWithDraft
            }
          />

        </div>

      )}


      {/* =====================================
          Article 13
          ===================================== */}

      {currentPage === "ARTICLE_13" && (

        <Article13Page
          onBack={goHome}
        />

      )}


      {/* =====================================
          Article 14
          ===================================== */}

      {currentPage === "ARTICLE_14" && (

        <Article14Page
          onBack={goHome}
        />

      )}


      {/* =====================================
          Water Engineering
          Articles 15 - 21
          ===================================== */}

      {currentPage ===
        "WATER_ENGINEERING" && (

        <WaterEngineeringPage

          onBack={goHome}

          onOpenArticle11={
            openArticle11
          }

        />

      )}


      {/* =====================================
          Metals and Mining
          Article 22
          ===================================== */}

      {currentPage ===
        "METALS_AND_MINING" && (

        <MetalsAndMiningPage
          onBack={goHome}
        />

      )}


      {/* =====================================
          Movable Property
          Article 23
          ===================================== */}

      {currentPage ===
        "MOVABLE_PROPERTY" && (

        <MovablePropertyPage
          onBack={goHome}
        />

      )}


      {/* =====================================
          Financial Affairs
          Articles 25 - 29
          ===================================== */}

      {currentPage ===
        "FINANCIAL_AFFAIRS" && (

        <FinancialAffairsPage
          onBack={goHome}
        />

      )}


      {/* =====================================
          Vehicles
          Articles 31 - 32
          ===================================== */}

      {currentPage ===
        "VEHICLES" && (

        <VehiclePage
          onBack={goHome}
        />

      )}



      {currentPage === "ROAD_BUILDING" && <RoadBuildingPage onBack={goHome} />}
      {currentPage === "INDUSTRY_TECHNOLOGY" && <IndustryTechnologyPage onBack={goHome} />}
      {currentPage === "AGRICULTURE_NATURAL_RESOURCES" && <AgricultureNaturalResourcesPage onBack={goHome} />}
      {currentPage === "EXPERT_RECORDS" && (
        <ExpertRecordsPage
          onBack={goHome}
          initialDraft={
            pendingExpertCaseDraft
          }
          onDraftConsumed={() =>
            setPendingExpertCaseDraft(
              null
            )
          }
        />
      )}

      {/* =====================================
          About
          ===================================== */}

      {currentPage === "ABOUT" && (
        <AboutPage onBack={goHome} />
      )}


      {/* =====================================
          Footer
          ===================================== */}

      <footer
        style={{
          marginTop: 40,
          padding: "18px 20px",
          borderTop: "1px solid #e2e8f0",
          background: "#ffffff",
          textAlign: "center",
          fontSize: 13,
          opacity: 0.9
        }}
      >
        <button
          type="button"
          onClick={openAbout}
          style={{
            border: "none",
            background: "transparent",
            color: "#0d47a1",
            cursor: "pointer",
            fontFamily: "inherit",
            fontSize: 13,
            fontWeight: 700,
            padding: "4px 8px"
          }}
        >
          درباره نرم‌افزار
        </button>

        <div
          style={{
            marginTop: 6,
            color: "#64748b",
            fontSize: 12
          }}
        >
          نسخه 1.0
        </div>
      </footer>

    </div>

  );
}